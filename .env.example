# =========================================================================
# Manufacturing ERP - Environment Variables Configuration
# =========================================================================

# Environment Mode: development | staging | production
NODE_ENV=development

# -------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# -------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_admin
DB_PASSWORD=erp_secret_pass_2026
DB_NAME=manufacturing_erp
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public&sslmode=prefer

# -------------------------------------------------------------------------
# Cache & Broker Configuration (Redis 7)
# -------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2026
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# -------------------------------------------------------------------------
# Backend Server Configuration
# -------------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# -------------------------------------------------------------------------
# Security & JWT Authentication
# -------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_manufacturing_erp_prod_2026_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_manufacturing_erp_prod_2026
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# -------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Apex Manufacturing ERP"

# -------------------------------------------------------------------------
# Developer Tools (Optional)
# -------------------------------------------------------------------------
PGADMIN_EMAIL=admin@mfg-erp.local
PGADMIN_PASSWORD=admin_secret_2026
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
